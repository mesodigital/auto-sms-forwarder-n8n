        "jsCode": "const rawData = items[0].json.body.raw_data;\n\n// Regex yang lebih kuat untuk menangkap body sampai akhir string meskipun ada baris baru\nconst extract = (key) => {\n  const regex = new RegExp(`${key}=(.*?)(?:, \\\\w+=|$)`, 's'); \n  const match = rawData.match(regex);\n  return match ? match[1].trim() : null;\n};\n\nconst address = extract('address');\nconst body = extract('body');\nconst timestamp = parseInt(extract('date'));\n\n// Mengonversi timestamp ke format waktu Indonesia yang mudah dibaca\nconst dateTime = new Date(timestamp).toLocaleString('id-ID', {\n  timeZone: 'Asia/Jakarta',\n  dateStyle: 'medium',\n  timeStyle: 'short'\n});\n\nreturn [\n  {\n    json: {\n      Sender: address,\n      Message: body,\n      Time: dateTime,\n      RawTimestamp: timestamp\n    }\n  }\n];"
      },
